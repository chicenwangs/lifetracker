{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CLAUDE.md"],
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },

    { "action": "edit", "resource": "mobile/**", "effect": "deny" },
    { "action": "edit", "resource": "deploy/**", "effect": "deny" },
    { "action": "edit", "resource": ".github/**", "effect": "deny" },
    { "action": "edit", "resource": "data/**", "effect": "deny" },
    { "action": "edit", "resource": "qa/**", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/**", "effect": "deny" },
    { "action": "edit", "resource": "CLAUDE.md", "effect": "deny" },
    { "action": "edit", "resource": "AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "app/drizzle/**", "effect": "deny" },
    { "action": "edit", "resource": "**/.env*", "effect": "deny" },

    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git merge*", "effect": "deny" },
    { "action": "shell", "resource": "git rebase*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git tag*", "effect": "deny" },
    { "action": "shell", "resource": "git worktree*", "effect": "deny" },
    { "action": "shell", "resource": "git fetch*", "effect": "deny" },
    { "action": "shell", "resource": "git add -A*", "effect": "deny" },
    { "action": "shell", "resource": "git add .*", "effect": "deny" },
    { "action": "shell", "resource": "git commit --amend*", "effect": "deny" },
    { "action": "shell", "resource": "gh *", "effect": "deny" },
    { "action": "shell", "resource": "adb*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf*", "effect": "deny" },
    { "action": "shell", "resource": "Remove-Item*-Recurse*", "effect": "deny" }
  ]
}
