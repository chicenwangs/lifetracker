# Copy to .env next to compose.yaml. chmod 600 .env. Never commit it.
# The tunnel token goes in tunnel.env (see tunnel.env.example), not here.

# --- release ---
# Image tag to run (a GitHub Release, without the v). Change this to upgrade or roll back.
APP_VERSION=2.0.0

# --- app (required) ---
# Public URL, exactly as the browser shows it. No trailing slash.
#   Stage B LAN test: http://<homelab-ip>:3000     Stage C: https://planner.jeremyjosh.org
ORIGIN=https://planner.jeremyjosh.org
# 32+ random chars. Generate: openssl rand -base64 48
# Signs share codes, invites, busy ids. Changing it voids unused codes only. Keep it in your password manager.
APP_SECRET=
TZ=Asia/Kuala_Lumpur
PORT=3000
HOST=0.0.0.0

# --- uploads (v2) ---
# Files live in data/uploads (on the volume) unless set. Max size per file, bytes (D-12: 25 MB).
# The image sets BODY_SIZE_LIMIT=26M so uploads reach the app; JSON routes stay capped at 1 MB in the app.
UPLOAD_DIR=
MAX_UPLOAD_BYTES=26214400

# --- first run only ---
# Needed to open /setup and create the admin. Delete the line after setup and restart.
SETUP_TOKEN=

# --- behind Cloudflare Tunnel (Stage C) ---
# Real client IP header from Cloudflare. Requests without it get 400 (except /healthz).
ADDRESS_HEADER=CF-Connecting-IP
# Pin a dated tag from hub.docker.com/r/cloudflare/cloudflared/tags (e.g. 2025.11.1). Avoid latest.
CLOUDFLARED_VERSION=
