{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CLAUDE.md"],
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },

    { "action": "edit", "resource": "app/**", "effect": "deny" },
    { "action": "edit", "resource": "mobile/**", "effect": "deny" },
    { "action": "edit", "resource": "docs/**", "effect": "deny" },
    { "action": "edit", "resource": "sprint/**", "effect": "deny" },
    { "action": "edit", "resource": "qa/**", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/**", "effect": "deny" },
    { "action": "edit", "resource": ".github/**", "effect": "deny" },
    { "action": "edit", "resource": "CLAUDE.md", "effect": "deny" },
    { "action": "edit", "resource": "AGENTS.md", "effect": "deny" },

    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git commit*", "effect": "deny" },
    { "action": "shell", "resource": "git merge*", "effect": "deny" },
    { "action": "shell", "resource": "git rebase*", "effect": "deny" },
    { "action": "shell", "resource": "git reset*", "effect": "deny" },
    { "action": "shell", "resource": "git tag*", "effect": "deny" },
    { "action": "shell", "resource": "git worktree*", "effect": "deny" },
    { "action": "shell", "resource": "gh pr *", "effect": "deny" },
    { "action": "shell", "resource": "gh issue close*", "effect": "deny" },
    { "action": "shell", "resource": "gh issue delete*", "effect": "deny" },
    { "action": "shell", "resource": "gh issue edit*", "effect": "deny" },
    { "action": "shell", "resource": "gh issue lock*", "effect": "deny" },
    { "action": "shell", "resource": "gh api*", "effect": "deny" },
    { "action": "shell", "resource": "gh repo*", "effect": "deny" },
    { "action": "shell", "resource": "gh release*", "effect": "deny" },
    { "action": "shell", "resource": "gh secret*", "effect": "deny" },
    { "action": "shell", "resource": "gh workflow*", "effect": "deny" },
    { "action": "shell", "resource": "gh label delete*", "effect": "deny" },
    { "action": "shell", "resource": "*planner.jeremyjosh.org*", "effect": "deny" },
    { "action": "shell", "resource": "*data/app.db*", "effect": "deny" },
    { "action": "shell", "resource": "*data\\app.db*", "effect": "deny" },
    { "action": "shell", "resource": "adb install*", "effect": "deny" },
    { "action": "shell", "resource": "*adb*install*", "effect": "deny" },
    { "action": "shell", "resource": "*gate.ps1*", "effect": "deny" },
    { "action": "shell", "resource": "docker*", "effect": "deny" },
    { "action": "shell", "resource": "ssh*", "effect": "deny" }
  ]
}
