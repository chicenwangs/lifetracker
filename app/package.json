{
	"name": "life-tracker",
	"private": true,
	"version": "2.0.2",
	"type": "module",
	"engines": {
		"node": ">=22 <23"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file=.env build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:seed": "tsx scripts/seed.ts",
		"reset-password": "node scripts/reset-password.mjs",
		"test:unit": "vitest run",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@date-fns/tz": "^1.5.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fullcalendar/core": "^6.1.22",
		"@fullcalendar/daygrid": "^6.1.22",
		"@fullcalendar/interaction": "^6.1.22",
		"@fullcalendar/timegrid": "^6.1.22",
		"@node-rs/argon2": "^2.2.2",
		"@tiptap/core": "3.33.1",
		"@tiptap/extension-image": "3.33.1",
		"@tiptap/extension-list": "3.33.1",
		"@tiptap/extension-table": "3.33.1",
		"@tiptap/pm": "3.33.1",
		"@tiptap/starter-kit": "3.33.1",
		"@tiptap/suggestion": "3.33.1",
		"better-sqlite3": "12.11.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.4",
		"graphology": "0.26.0",
		"graphology-layout-forceatlas2": "0.10.1",
		"isomorphic-dompurify": "^4.6.0",
		"marked": "^18.1.3",
		"sigma": "4.0.6",
		"web-push": "4.0.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.20.5",
		"@types/web-push": "3.6.4",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	}
}
