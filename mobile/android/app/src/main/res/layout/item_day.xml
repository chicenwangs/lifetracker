<?xml version="1.0" encoding="utf-8"?>
<!-- week ahead: day + count · first three things -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/wripple"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">
    <LinearLayout android:layout_width="84dp" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:lineSpacingExtra="3dp" android:maxLines="3" android:textSize="13sp" />
</LinearLayout>
