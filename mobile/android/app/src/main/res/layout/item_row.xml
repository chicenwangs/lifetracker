<?xml version="1.0" encoding="utf-8"?>
<!-- timeline row like Today: time · coloured box with tick + title; now = band behind the whole row -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="6dp">
    <ImageView android:id="@+id/band" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/wfill" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="4dp">
        <LinearLayout android:layout_width="52dp" android:layout_height="wrap_content" android:gravity="end" android:orientation="vertical" android:paddingEnd="8dp">
            <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" />
        </LinearLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <ImageView android:id="@+id/boxBg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/wfill" />
            <LinearLayout android:id="@+id/box" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/wripple" android:gravity="center_vertical" android:minHeight="44dp" android:orientation="horizontal" android:paddingEnd="10dp">
    <FrameLayout
        android:id="@+id/chk"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Mark done">
        <ImageView android:id="@+id/chkBox" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_box" />
        <ImageView android:id="@+id/chkTick" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_tick" android:visibility="gone" />
    </FrameLayout>
                <TextView android:id="@+id/text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
