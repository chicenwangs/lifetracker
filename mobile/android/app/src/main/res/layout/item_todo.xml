<?xml version="1.0" encoding="utf-8"?>
<!-- to-do row: tick · type dot · title -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/wripple"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal">
    <FrameLayout
        android:id="@+id/chk"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Mark done">
        <ImageView android:id="@+id/chkBox" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_box" />
        <ImageView android:id="@+id/chkTick" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_tick" android:visibility="gone" />
    </FrameLayout>
    <ImageView android:id="@+id/dot" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="8dp" android:importantForAccessibility="no" android:src="@drawable/wfill" />
    <TextView android:id="@+id/text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:textSize="14sp" />
</LinearLayout>
