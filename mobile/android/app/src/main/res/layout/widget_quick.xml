<?xml version="1.0" encoding="utf-8"?>
<!-- Quick add: one tap to plan something or jot a note -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/wcard_light" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingTop="10dp" android:paddingEnd="14dp" android:paddingBottom="16dp">
        <TextView android:id="@+id/plan" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/wpill_accent" android:gravity="center" android:paddingStart="3dp" android:paddingBottom="3dp" android:text="+ Plan" android:textColor="#FF00003D" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/note" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/wpill_soft_light" android:gravity="center" android:paddingStart="3dp" android:paddingBottom="3dp" android:text="+ Note" android:textColor="#FF00003D" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
