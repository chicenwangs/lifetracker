<?xml version="1.0" encoding="utf-8"?>
<!-- widget card (light): the app's card = border + hard yellow shadow down-left (app.css --shadow-card) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:right="6dp" android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFF3D053" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="1.5dp" android:color="#FF00003D" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
