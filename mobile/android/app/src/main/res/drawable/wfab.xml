<?xml version="1.0" encoding="utf-8"?>
<!-- yellow + button like the app's bottom-bar Add: border + hard shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:right="3dp" android:top="3dp">
        <shape android:shape="oval"><solid android:color="#FF00003D" /></shape>
    </item>
    <item android:left="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFF3D053" />
            <stroke android:width="1.5dp" android:color="#FF00003D" />
        </shape>
    </item>
</layer-list>
